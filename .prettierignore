# Prettier ignore list — see BM-028 (formatting baseline).
# Everything not listed here is expected to pass `npm run format:check`,
# which CI enforces (.github/workflows/format.yml).

# --- Dependencies -----------------------------------------------------------
node_modules
package-lock.json
react-app/package-lock.json

# --- Build output (generated by build.sh / next build) ----------------------
dist
release
.next
react-app/.next
react-app/out

# --- Test output (generated by Playwright) ----------------------------------
test-results
playwright-report
blob-report
.playwright

# --- Generated / vendored assets --------------------------------------------
# Minified bundles: formatting them would undo the minification.
*.min.js
*.min.css
*.min.json

# Mati barangay dataset: `data/mati/data/` is a gitignored download cache and
# `data/mati/dist/` is generated output — both are rebuilt by
# `data/mati/build_barangays.py`, so hand formatting would be overwritten.
data/mati/data
data/mati/dist

# Vendored copy of the static site's stylesheets, consumed by the React app
# via react-app/public/. Kept byte-comparable to its source in assets/css/.
react-app/public/assets
